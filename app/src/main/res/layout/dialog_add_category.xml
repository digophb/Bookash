<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Toggle Receita/Despesa -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/typeToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:selectionRequired="true"
        app:singleSelection="true"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIncome"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Receita"
            android:textColor="@color/primary"
            app:icon="@drawable/ic_arrow_up"
            app:iconTint="@color/primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExpense"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Despesa"
            android:textColor="@color/error"
            app:icon="@drawable/ic_arrow_down"
            app:iconTint="@color/error" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Descrição -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Descrição"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxBackgroundColor="@color/surface"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/descriptionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="@color/text_primary" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Cor -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cor"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <View
            android:id="@+id/color1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@color/primary"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/color2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@color/error"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/color3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@color/text_secondary"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/color4"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@color/highlight_secondary"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:id="@+id/color5"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@color/success"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Ícone -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ícone"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icon1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_category_food"
            android:tint="@color/text_primary"
            android:padding="8dp"
            android:background="@color/surface"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/icon2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_category_transport"
            android:tint="@color/text_primary"
            android:padding="8dp"
            android:background="@color/surface"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/icon3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_category_home"
            android:tint="@color/text_primary"
            android:padding="8dp"
            android:background="@color/surface"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/icon4"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_category_health"
            android:tint="@color/text_primary"
            android:padding="8dp"
            android:background="@color/surface"
            android:layout_marginEnd="8dp" />

        <ImageView
            android:id="@+id/icon5"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_category_education"
            android:tint="@color/text_primary"
            android:padding="8dp"
            android:background="@color/surface" />

    </LinearLayout>

</LinearLayout>
