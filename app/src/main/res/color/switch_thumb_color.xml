<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Thumb ON - Branco para destacar no track verde -->
    <item android:color="@color/white" android:state_checked="true"/>
    <!-- Thumb OFF - Cinza claro para contrastar com track escuro -->
    <item android:color="#B8C9C0" android:state_checked="false"/>
</selector>
