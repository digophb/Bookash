<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Track ON - Verde primario para indicar ativado -->
    <item android:color="@color/primary" android:state_checked="true"/>
    <!-- Track OFF - Cinza escuro para indicar desativado -->
    <item android:color="#3D5A56" android:state_checked="false"/>
</selector>
