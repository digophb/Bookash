<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Bookash" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorAccent">@color/accent</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="hintTextColor">@color/text_secondary</item>
    </style>

    <!-- ====== INPUT STYLE PADRÃO ====== -->
    <!-- Cor padrão: #A3BBAD (text_secondary) para bordas e placeholders -->

    <style name="Widget.Bookash.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/input_border</item>
        <item name="hintTextColor">@color/input_placeholder</item>
        <item name="android:textColorHint">@color/input_placeholder</item>
    </style>

    <style name="Widget.Bookash.TextInputLayout.ExposedDropdownMenu" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/input_border</item>
        <item name="hintTextColor">@color/input_placeholder</item>
        <item name="android:textColorHint">@color/input_placeholder</item>
    </style>

    <style name="Widget.Bookash.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/input_placeholder</item>
    </style>

    <style name="Widget.Bookash.Chip.Outlined" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipStrokeColor">@color/text_secondary</item>
        <item name="chipBackgroundColor">@null</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="chipMinHeight">32dp</item>
    </style>

</resources>
