<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".BookashApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Bookash"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bookash"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">
        
        <!-- Onboarding - Tela inicial -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="true"
            android:theme="@style/Theme.Bookash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Bookash" />
        
        <!-- Registro -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        
        <!-- Main -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        
        <!-- Adicionar Transacao -->
        <activity
            android:name=".AddTransactionActivity"
            android:exported="false"
            android:theme="@style/Theme.Bookash" />
        
        <!-- Detalhes da Transacao -->
        <activity
            android:name=".TransactionDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Bookash" />
        
        <!-- Pendentes Activity -->
        <activity
            android:name=".PendingTransactionsActivity"
            android:exported="false"
            android:theme="@style/Theme.Bookash" />
        
        <!-- Categorias -->
        <activity
            android:name=".CategoriesActivity"
            android:exported="false"
            android:theme="@style/Theme.Bookash" />
        
        <!-- Adicionar/Editar Categoria -->
        <activity
            android:name=".AddCategoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Bookash" />
        
        <!-- Tags -->
        <activity
            android:name=".TagsActivity"
            android:exported="false"
            android:theme="@style/Theme.Bookash" />
        
        <!-- Adicionar/Editar Tag -->
        <activity
            android:name=".AddTagActivity"
            android:exported="false"
            android:theme="@style/Theme.Bookash" />
        
        <!-- Contas -->
        <activity
            android:name=".AccountsActivity"
            android:exported="false"
            android:theme="@style/Theme.Bookash" />
        
        <!-- Adicionar/Editar Conta -->
        <activity
            android:name=".AddAccountActivity"
            android:exported="false"
            android:theme="@style/Theme.Bookash" />
        
        <!-- Mais Opções -->
        <activity
            android:name=".MoreOptionsActivity"
            android:exported="false"
            android:theme="@style/Theme.Bookash" />
        
        <!-- Transactions Activity -->
        <activity
            android:name=".TransactionsActivity"
            android:exported="false"
            android:theme="@style/Theme.Bookash" />
        
        <!-- Goals Activity -->
        <activity
            android:name=".GoalsActivity"
            android:exported="false"
            android:theme="@style/Theme.Bookash" />
        
        <!-- FileProvider para compartilhar arquivos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
            
    </application>

</manifest>
